datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_BASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  DOCTOR
  STAFF
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(PATIENT)
  createdBy     String?
  editedBy      String?
  createdAt     DateTime @default(now())
  updatedAt DateTime @updatedAt
}

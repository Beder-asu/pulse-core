datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_BASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model InvoiceStatus {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String    @unique // "DRAFT", "ISSUED", "PAID", "CANCELLED"
  description String?
  invoices    Invoice[]
  createdBy   String?   @db.Uuid
  editedBy    String?   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt   DateTime  @updatedAt
}

model Invoice {
  id          String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  patientId   String        @db.Uuid
  totalAmount Float         @default(0.0)
  statusId    String        @db.Uuid
  status      InvoiceStatus @relation(fields: [statusId], references: [id])
  items       InvoiceItem[]
  issuedAt    DateTime?
  paidAt      DateTime?
  createdBy   String?       @db.Uuid
  editedBy    String?       @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([patientId])
}

model InvoiceItem {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  invoiceId   String   @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sourceId    String   @db.Uuid // Foreign key to Appointment/LabOrder/Prescription
  sourceType  String   // "APPOINTMENT", "LAB", "PHARMACY"
  description String
  amount      Float
}

// Prevents Kafka from processing the same event twice
model ProcessedEvent {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  eventId     String   @unique @db.Uuid
  processedAt DateTime @default(now())
}

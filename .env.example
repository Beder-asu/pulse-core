# Copy this file to .env for local Docker Compose development.
# Do not commit .env. Use strong unique values outside local demos.

POSTGRES_USER=replace-with-local-db-user
POSTGRES_PASSWORD=replace-with-local-db-password

JWT_SECRET=replace-with-long-random-jwt-secret
INTERNAL_SERVICE_SECRET=replace-with-long-random-internal-service-secret

DEMO_USER_PASSWORD=replace-with-local-demo-user-password

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-local-grafana-password
